    post:
      operationId: paiements_reservations_initier_create
      description: Crée ou reprend une tentative de paiement pour une réservation
        du voyageur connecté. La réponse inclut payment_url pour rediriger le voyageur
        vers la page sécurisée FedaPay.
      parameters:
      - in: path
        name: reservation_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - paiements
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
