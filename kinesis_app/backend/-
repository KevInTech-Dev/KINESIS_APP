  /api/v1/billets/:
    get:
      operationId: billets_list
      description: Liste paginée des billets du voyageur connecté. Un agent de compagnie
        ayant la permission VALIDER_EMBARQUEMENT voit uniquement les billets de sa
        compagnie; le QR code secret n’est pas inclus dans cette liste.
      parameters:
      - name: page
        required: false
        in: query
        description: Un numéro de page de l'ensemble des résultats.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Nombre de résultats à retourner par page.
        schema:
          type: integer
      tags:
      - billets
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedBilletCompagnieList'
          description: ''
