    post:
      operationId: billets_voyages_depart_create
      description: Enregistre le départ réel d’un voyage de la compagnie de l’agent.
        Les billets encore VALIDE passent immédiatement à NON_UTILISE; ceux déjà EMBARQUE
        restent EMBARQUE.
      parameters:
      - in: path
        name: voyage_id
        schema:
          type: string
          format: uuid
