SECRET_KEY=remplace-par-une-cle-secrete
DEBUG=True
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE_NEON/BASE?sslmode=require

CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ta_cle_api
CLOUDINARY_API_SECRET=ton_secret_api
# Optional TLS Redis connection URL (e.g. Upstash TCP):
# rediss://default:TOKEN@HOST:PORT
REDIS_URL=
# Backend logs API requests slower than this threshold.
SLOW_REQUEST_LOG_THRESHOLD_MS=500

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use a sender name and an address verified by your email provider (e.g. Brevo).
DEFAULT_FROM_NAME=KINESIS
DEFAULT_FROM_EMAIL=noreply@kinesis.local
# Public base URL of the Next.js frontend; activation links are sent to this host.
FRONTEND_BASE_URL=http://localhost:3000
# Invitation links expire after 48 hours (value in seconds).
AGENT_INVITATION_MAX_AGE=172800

# CinetPay API credentials. Sandbox: https://api.cinetpay.net
# Production: https://api.cinetpay.co
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_API_BASE_URL=https://api.cinetpay.net
# Public HTTPS endpoint; must be reachable by CinetPay and at most 120 characters.
CINETPAY_NOTIFY_URL=
# Optional override; by default the frontend payment return URL is used.
CINETPAY_RETURN_URL=

# Legacy FedaPay credentials are only needed to reconcile existing transactions.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CALLBACK_URL=